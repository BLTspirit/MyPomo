<Window x:Class="MyPomo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyPomo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="LightGray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.05*"/>
            <RowDefinition Height="0.95*"/>

        </Grid.RowDefinitions>
        <!-- Header Menu-->
        <Rectangle Grid.Row="0" Fill="Black" Opacity="0.1"/>


        <!--Timer Rectangle Area-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.6*"/>
                <RowDefinition Height="0.2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="0.4*"/>
                <ColumnDefinition Width="0.2*"/>
            </Grid.ColumnDefinitions>
            <!-- Timer Display Area -->
            <Border Opacity="0.1" Background="Black" Grid.Row="1" Grid.Column="1" CornerRadius="12"></Border>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12" VerticalAlignment="Center">
                <!--Timer Mode Button Row-->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Pomodoro" Width="100" Height="30" Margin="6"/>
                    <Button Content="Short Break" Width="100" Height="30" Margin="6"/>
                </StackPanel>
                <!--Timer text-->
                <TextBlock x:Name="tbDisplay" Text="00:00:00" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!--Timer Controls-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="btnTimerToggle" Grid.Column="1" Content="Start" Width="100" Height="30" Margin="6" Click="ClickedTimerToggle"/>
                    <Button Grid.Column="2" Content="End" Width="50" Height="30" Margin="6" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
